@OBSThemeMeta {
    name: 'Empire (Netflix)';
    id: 'com.empireobs.Netflix';
    extends: 'com.obsproject.Yami';
    author: 'Empire OBS';
    dark: 'true';
}

@OBSThemeVars {
    /* === Netflix neutral ramp (light -> dark) === */
    --grey1: #4D4D4D;
    --grey2: #404040;
    --grey3: #333333;
    --grey4: #2A2A2A;
    --grey5: #1F1F1F;
    --grey6: #181818;
    --grey7: #141414;  /* Netflix signature surface */
    --grey8: #0B0B0B;

    /* === Netflix red accent === */
    --red1: #FF5C66;
    --red2: #F40612;
    --red3: #E50914;  /* Netflix red */
    --red4: #B20710;
    --red5: #7D0510;
    --red6: #590309;

    --primary: #E50914;
    --primary_light: #F40612;
    --primary_lighter: #FF5C66;
    --primary_dark: #B20710;
    --primary_darker: #7D0510;

    --danger: #E50914;

    /* === Base surfaces === */
    --bg_window: var(--grey8);
    --bg_base: var(--grey7);
    --bg_preview: #000000;

    /* === Text === */
    --text: #FFFFFF;
    --text_light: #FFFFFF;
    --text_muted: #B3B3B3;

    --highlight_color: var(--primary);

    /* === Rounded corners (8-12 px, cinematic) === */
    --border_radius: 8px;
    --border_radius_small: 6px;
    --border_radius_large: 12px;

    --border_color: var(--grey4);

    /* === Inputs === */
    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey6);

    --input_border: var(--grey3);
    --input_border_hover: var(--grey2);
    --input_border_focus: var(--primary);

    --list_item_bg_selected: var(--primary_dark);
    --list_item_bg_hover: var(--grey4);

    /* === Buttons === */
    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--grey6);
    --button_bg_disabled: var(--grey6);

    --button_bg_red: #E50914;
    --button_bg_red_hover: #F40612;
    --button_bg_red_down: #B20710;

    --button_border: var(--grey5);
    --button_border_hover: var(--button_bg_hover);
    --button_border_focus: var(--primary);

    /* === Tabs === */
    --tab_bg_down: var(--grey7);
    --tab_border_hover: var(--primary);
    --tab_border_focus: var(--primary);
    --tab_border_selected: var(--primary);

    /* === Scrollbars === */
    --scrollbar_handle: var(--grey4);
    --scrollbar_hover: var(--primary);
    --scrollbar_down: var(--primary_dark);
    --scrollbar_border: var(--grey5);

    /* === Tool buttons === */
    --toolbutton_bg: var(--grey5);
    --toolbutton_bg_hover: var(--grey4);
    --toolbutton_bg_down: var(--primary_dark);
}

/* === Cinematic, pure-black preview === */
OBSQTDisplay {
    qproperty-displayBackgroundColor: #000000;
}

/* === Typography: modern UI font with safe fallbacks === */
* {
    font-family: "Segoe UI", "Inter", "SF Pro Display", "Roboto", sans-serif;
}

/* === Panel / dock separation for a card-like feel === */
QDockWidget::title {
    background-color: var(--grey6);
}

QMenu::separator {
    background-color: var(--grey4);
}

/* === LIVE: primary control buttons glow Netflix-red when active === */
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--button_bg_red);
    border-color: var(--button_bg_red);
}

#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:hover:!pressed.state-active,
#virtualCamButton:hover:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--button_bg_red_hover);
    border-color: var(--button_bg_red_hover);
}

#streamButton:pressed.state-active,
#recordButton:pressed.state-active,
#pauseRecordButton:pressed.state-active,
#replayBufferButton:pressed.state-active,
#virtualCamButton:pressed.state-active,
#modeSwitch:pressed.state-active,
#broadcastButton:pressed.state-active {
    background: var(--button_bg_red_down);
    border-color: var(--button_bg_red_down);
}

/* === Scene / source list selection in Netflix red === */
.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:checked {
    background-color: var(--primary_dark);
}

.list-grid SceneTree::item:hover {
    background-color: var(--grey4);
}

.list-grid SceneTree::item:selected:hover {
    background-color: var(--primary);
}
